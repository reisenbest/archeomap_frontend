# Среда для запуска JavaScript: Node.js 22 в компактном Linux Alpine.
# Это тег образа, а не закреплённая локальная копия. При отсутствии образа Docker должен его скачать.
FROM node:22-alpine

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем package.json и package-lock.json в рабочую директорию
COPY package*.json ./

# Устанавливаем библиотеки из package.json. npm install может обновлять файл блокировки версий.
RUN npm install

# Копируем все файлы из текущей директории (кроме тех, которые указаны в .dockerignore) в рабочую директорию внутри контейнера
COPY . .

# Создаём готовые файлы сайта в /app/build.
RUN npm run build

# При запуске контейнера выполняется npm start — сервер разработки на порту 3000.
# Созданная выше папка build этой командой не раздаётся.
CMD ["npm", "start"]